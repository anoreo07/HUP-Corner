NEXT_PUBLIC_GOOGLE_MAP_API_KEY=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Telegram Bot (file storage)
# ⚠️ IMPORTANT: Get from @BotFather on Telegram
# Format: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# DO NOT SHARE THIS TOKEN!
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram Channel ID where files are stored
# Format: -100123456789 (starts with -100)
# How to get: Create private channel → add bot → send /start → check getUpdates
TELEGRAM_CHANNEL_ID=your-telegram-channel-id

# Public Telegram Channel ID (safe to expose to client)
NEXT_PUBLIC_TELEGRAM_CHANNEL_ID=your-telegram-channel-id

# Admin
ADMIN_PASSWORD=admin123